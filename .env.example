# --- Supabase (required for built-in chat persistence) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only: Dashboard → Settings → API Keys → secret key (never expose to the client).
# Exact name matters. Legacy JWT service_role also works:
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_sb_secret_key
# Alternative name if you prefer (same value as dashboard “secret” key):
# SUPABASE_SECRET_KEY=

# --- Claude in Next.js (default) ---
ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional override (default in app is claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Optional: Claude lives in a Supabase Edge Function ---
# When set, /api/ask forwards { conversationId, message, messages } to:
#   ${NEXT_PUBLIC_SUPABASE_URL}/functions/v1/${SUPABASE_CLAUDE_FUNCTION}
# Your function should return JSON: { "reply": "..." }
# Next.js still saves the assistant message to wholara_messages after.
# SUPABASE_CLAUDE_FUNCTION=ask-wholara

# --- Optional: full proxy (your function owns request/response + DB) ---
# When set, POST /api/ask is forwarded as-is to this URL (see app/api/ask/route.ts).
# SUPABASE_CHAT_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/your-fn
# SUPABASE_CHAT_FUNCTION_BEARER=your_anon_or_service_key

# --- Voyage AI (query embeddings for RAG against the `documents` table) ---
# Server-only. Model `voyage-3` produces 1024-dim vectors matching the documents.embedding column.
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Resend (consultation form email delivery) ---
# Server-only: dashboard.resend.com → API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides — defaults below are what the action falls back to:
#   from: Wholara <contact@wholara.org>   (domain wholara.org must be verified in Resend)
#   to:   JLGarrahan@wholara.org
# RESEND_FROM_EMAIL=Wholara <contact@wholara.org>
# CONSULTATION_TO_EMAIL=JLGarrahan@wholara.org

# --- Stripe (Ask Wholara Premium upgrade) ---
# Server-only. Powers POST /api/checkout/premium, which the "Upgrade Here"
# button hits once a user runs out of free preview questions.
STRIPE_SECRET_KEY=sk_live_or_test_xxxxxxxxxxxxxxxxxxxxxxxx
# The recurring Price id for the $9/month Ask Wholara Premium plan.
STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: used for Stripe success/cancel return URLs when the request has no
# Origin header (e.g. some server contexts). Otherwise the request origin is used.
# NEXT_PUBLIC_SITE_URL=https://wholara.org
